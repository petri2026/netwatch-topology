# ── Netwatch Environment ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Default SSH credentials (can be overridden per-request)
DEFAULT_SSH_USER=admin
DEFAULT_SSH_PASSWORD=

# Scrapli transport: asyncssh (recommended) | system
SCRAPLI_TRANSPORT=asyncssh

# Connection timeouts (seconds)
SSH_CONNECT_TIMEOUT=20
SSH_AUTH_TIMEOUT=15
SSH_COMMAND_TIMEOUT=60

# Maximum simultaneous SSH sessions
MAX_CONCURRENT_SESSIONS=10

# CORS — comma-separated origins (use * for dev only)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
